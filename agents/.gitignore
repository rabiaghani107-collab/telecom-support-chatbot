# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
.Python

# VS Code / IDE
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Logs and runtime files
*.log
logs/
*.pid
*.sock

# OS files
.DS_Store
Thumbs.db

# Python test / tooling cache
.pytest_cache/
htmlcov/
.coverage
coverage.xml
.cache/
.mypy_cache/
docs/_build/

# Temporary files
*.tmp
*.temp
*.bak
*.swp

# Secrets / environment
# DO NOT commit .env or any env files containing keys
.env
.env.* 
# Also ignore any .env that may have been placed inside subfolders
**/.env
**/.env.*

# Databases and large generated data
*.sqlite3
*.db
data/*.db
data/chroma_db/
telecom.db
*.mdb

# Vector stores / embeddings / knowledge base artifacts (common names)
knowledge_base/
knowledge_base/*
# If you DO want to keep the KB repo in git, remove the previous two lines
# and add more specific ignores below instead:
# knowledge_base/*.pkl
# knowledge_base/vectorstore/

# Cache / generated model artifacts
*.bin
*.npz
*.ckpt
models/
cache/

# Package manager files
pip-log.txt
pip-delete-this-directory.txt

# Jupyter
.ipynb_checkpoints
*.ipynb

# Other common
*.pem
*.key

# Ensure core source folders remain tracked (these are just notes — not necessary):
# agents/
# config/
# tools/